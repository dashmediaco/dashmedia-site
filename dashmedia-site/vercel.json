{
  "functions": {
    "api/contact.js": {
      "maxDuration": 10
    },
    "api/client-portals.js": {
      "maxDuration": 15
    },
    "api/client-launch.js": {
      "maxDuration": 15
    },
    "api/ghl-user-sync.js": {
      "maxDuration": 15
    },
    "api/ghl-user-poll-sync.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/client-login",
      "destination": "https://login.dashmediaco.com/",
      "permanent": false
    },
    {
      "source": "/agency",
      "destination": "https://login.dashmediaco.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dashmediaco.com"
        }
      ],
      "destination": "https://dashmediaco.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/ghl-user-poll-sync",
      "schedule": "* * * * *"
    }
  ]
}
