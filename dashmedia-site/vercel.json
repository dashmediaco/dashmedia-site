{
  "functions": {
    "api/contact.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/client-login",
      "destination": "/api/client-login"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dashmediaco.com"
        }
      ],
      "destination": "https://dashmediaco.com/:path*",
      "permanent": true
    }
  ]
}
